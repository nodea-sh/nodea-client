{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window's frontend may call. Mirrors the v1 allowlist.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://app.getnodea.com/*" },
        { "url": "https://github.com/nodea-sh/nodea-client/releases/*" }
      ]
    }
  ]
}
