{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodea",
  "mainBinaryName": "Nodea",
  "version": "0.1.0",
  "identifier": "com.getnodea.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../LICENSE", "../NOTICE", "../THIRD_PARTY_LICENSES.md"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "c00cab28-27d5-5e3e-8e36-e12baad322b3"
      }
    },
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nodea"]
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-icon-template.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "",
        "width": 1200,
        "height": 800,
        "url": "?demo=false",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "transparent": false,
        "useHttpsScheme": true
      }
    ]
  }
}
